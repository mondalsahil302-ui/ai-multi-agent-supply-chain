APP_ENV=local

MONGO_URI=mongodb://localhost:27017
MONGO_DATABASE=demand_agent
MONGO_USERNAME=
MONGO_PASSWORD=
MONGO_AUTH_SOURCE=demand_agent
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000
MONGO_CONNECT_TIMEOUT_MS=5000
MONGO_SOCKET_TIMEOUT_MS=20000

OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast

CALENDARIFIC_BASE_URL=https://calendarific.com/api/v2/holidays
CALENDARIFIC_API_KEY=

DEFAULT_TIMEZONE=Asia/Kolkata
DEFAULT_COUNTRY=IN
DEFAULT_REGION_CODE=IN-WB
DEFAULT_FORECAST_DAYS=7
HISTORICAL_DEMAND_DATASET_PATH=agent_demand_integrated.txt
REGION_MASTER_DATASET_PATH=region_master.csv
PRODUCT_MASTER_DATASET_PATH=
INGESTION_BATCH_SIZE=500
WEATHER_HISTORY_LOOKBACK_DAYS=2
WEATHER_BACKFILL_START_DATE=
FESTIVAL_CONTEXT_MONTHS=12
FESTIVAL_CACHE_TTL_HOURS=720
WEATHER_INGESTION_SCHEDULE=0 1 * * *
FESTIVAL_INGESTION_SCHEDULE=0 2 1 * *

HTTP_TIMEOUT_SECONDS=20
HTTP_MAX_RETRIES=3
HTTP_BACKOFF_MAX_SECONDS=30
