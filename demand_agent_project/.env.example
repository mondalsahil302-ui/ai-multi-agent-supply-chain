# =====================================================================
# DEMAND AGENT .env  (v1: no Redis, training offline, weekly batch)
# Never commit this file. Commit .env.example (same keys, no secrets).
# =====================================================================

# ---------- GLOBAL ----------
APP_ENV=dev
LOG_LEVEL=INFO
TIMEZONE=Asia/Kolkata
REGION_ID=KOL-LOC-001
REGION_NAME=Lake Gardens
WEEK_START_DAY=SUNDAY
FORECAST_HORIZON_WEEKS=1

# ---------- BLOCK 3: MONGODB ----------
MONGO_URI=mongodb://localhost:27017
MONGO_DATABASE=demand_agent
MONGO_USERNAME=demand_agent
MONGO_PASSWORD=CHANGE_ME
MONGO_AUTH_SOURCE=demand_agent
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000
MONGO_CONNECT_TIMEOUT_MS=5000
MONGO_SOCKET_TIMEOUT_MS=20000
COL_REGION_MASTER=region_master
COL_PRODUCT_MASTER=product_master
COL_CALENDAR_WEEKS=calendar_weeks
COL_WEATHER_HISTORY=weather_history
COL_WEATHER_FORECASTS=weather_forecasts
COL_FESTIVAL_CALENDAR=festival_calendar
COL_FESTIVAL_WEEK_FEATURES=festival_week_features
COL_HISTORICAL_DEMAND=historical_demand
COL_SALES_HISTORY=sales_history
COL_DEMAND_FEATURES=demand_features
COL_FORECAST_RESULTS=forecast_results
COL_RUN_METADATA=run_metadata
COL_INGESTION_ERRORS=ingestion_errors
COL_QUARANTINE=quarantine_data

# ---------- BLOCK 1/2: EXTERNAL APIS + INGESTION ----------
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive
REGION_LATITUDE=22.50574
REGION_LONGITUDE=88.35672
WEATHER_FORECAST_DAYS=16

CALENDARIFIC_API_KEY=CHANGE_ME
CALENDARIFIC_BASE_URL=https://calendarific.com/api/v2
CALENDARIFIC_COUNTRY=IN
CALENDARIFIC_STATE=IN-WB

API_TIMEOUT_SECONDS=15
API_MAX_RETRIES=3
API_RETRY_BACKOFF_SECONDS=2

WEATHER_TEMP_MIN_C=5
WEATHER_TEMP_MAX_C=48
WEATHER_RAIN_MAX_MM_WEEK=1500
WEATHER_HUMIDITY_MIN_PCT=0
WEATHER_HUMIDITY_MAX_PCT=100
SOURCE_MAX_STALENESS_HOURS=48

AIRFLOW_HOME=./airflow
AIRFLOW__CORE__LOAD_EXAMPLES=False
WEATHER_DAG_SCHEDULE=0 2 * * *
FESTIVAL_DAG_SCHEDULE=0 3 * * 1

# ---------- BLOCK 4: OFFLINE TRAINING ----------
MODEL_ALGORITHM=lightgbm
TRAIN_RANDOM_SEED=42
TRAIN_EXCLUDE_SYNTHETIC=true
TRAIN_EXCLUDE_PARTIAL_WEEKS=true
BACKTEST_N_FOLDS=4
BACKTEST_HORIZON_WEEKS=4
MIN_HISTORY_WEEKS=52

GATE_METRIC=wape
GATE_MAX_WAPE=0.35
GATE_MIN_IMPROVEMENT_VS_BASELINE=0.05
GATE_MAX_ABS_BIAS_PCT=0.10

MLFLOW_TRACKING_URI=./mlruns
MLFLOW_EXPERIMENT_NAME=demand_agent_lightgbm
MLFLOW_REGISTERED_MODEL_NAME=demand_lightgbm_weekly
MLFLOW_CHAMPION_ALIAS=champion
MODEL_ARTIFACT_DIR=./artifacts/models

# ---------- BLOCK 5: WEEKLY FORECAST EXECUTION ----------
FORECAST_SCHEDULE=0 6 * * 0
MAX_TASK_WORKERS=4
FEATURE_SCHEMA_VERSION=v1
PREDICTION_MIN_UNITS=0
PREDICTION_MAX_MULTIPLIER_VS_HISTORY=5
FLAG_SYNTHETIC_LOOKBACK=true

API_HOST=127.0.0.1
API_PORT=8000
API_AUTH_MODE=api_key
API_KEY=CHANGE_ME
JWT_SECRET=CHANGE_ME
JWT_EXPIRY_MINUTES=60

# ---------- BLOCK 6: RECOVERY CONTROL ----------
FALLBACK_MODEL_ENABLED=true
BASELINE_ENABLED=true
BASELINE_METHOD=rolling_seasonal
BASELINE_ROLLING_WEEKS=8
BASELINE_MIN_HISTORY_WEEKS=12
ALERT_CHANNEL=log
ALERT_EMAIL_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ---------- BLOCK 7: EXPLANATION (NON-BLOCKING) ----------
EXPLANATION_ENABLED=true
SHAP_TOP_K_FEATURES=5
SHAP_SAMPLE_SIZE=200
LLM_PROVIDER=gemini
LLM_API_KEY=CHANGE_ME
LLM_MODEL=gemini-3.5-flash
LLM_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=1
EXPLANATION_MAX_CHARS=800
RAG_ENABLED=false
RAG_SOURCE_PATH=./rag_docs

# ---------- COORDINATOR HANDOFF ----------
COORDINATOR_CALLBACK_URL=
COORDINATOR_API_KEY=